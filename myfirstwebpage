<style>

  :root{
    --ink:#161B22;
    --paper:#F6F4EE;
    --paper-dim:#EFEBE1;
    --teal:#2F5D50;
    --teal-soft:#e4ece9;
    --gold:#A9791F;
    --line:#DAD5C8;
    --muted:#6B6A63;
    --max:1040px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}

  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
    font-size:16px;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }

  ::selection{background:var(--teal); color:var(--paper);}

  a{color:inherit;}
  a:focus-visible, button:focus-visible{outline:2px solid var(--teal); outline-offset:3px;}

  h1,h2,h3{
    font-family:'Fraunces', serif;
    font-weight:480;
    margin:0;
    letter-spacing:-0.01em;
  }

  .wrap{max-width:var(--max); margin:0 auto; padding:0 32px;}

  .mono{
    font-family:'IBM Plex Mono', monospace;
    font-size:12.5px;
    letter-spacing:0.02em;
  }

  /* ---------- NAV ---------- */
  nav{
    position:sticky; top:0; z-index:40;
    background:rgba(246,244,238,0.88);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  nav .wrap{
    display:flex; align-items:center; justify-content:space-between;
    padding-top:16px; padding-bottom:16px;
  }
  .nav-name{font-family:'Fraunces', serif; font-size:17px; font-weight:600;}
  .nav-links{display:flex; gap:28px; list-style:none; margin:0; padding:0;}
  .nav-links a{text-decoration:none; font-size:14px; color:var(--muted); transition:color .15s ease;}
  .nav-links a:hover{color:var(--ink);}
  .nav-links{display:none;}
  @media(min-width:720px){.nav-links{display:flex;}}

  /* ---------- HERO ---------- */
  header.hero{padding:96px 0 56px;}
  .role-line{
    color:var(--teal);
    font-size:14.5px;
    margin-bottom:22px;
  }
  h1.display{
    font-size:clamp(40px, 7vw, 72px);
    line-height:1.04;
    max-width:11ch;
  }
  .lede{
    max-width:52ch;
    margin-top:26px;
    font-size:18px;
    color:#3A3E35;
  }
  .contact-row{
    margin-top:34px;
    display:flex; flex-wrap:wrap; gap:10px 22px;
    font-size:14.5px;
  }
  .contact-row a{text-decoration:none; border-bottom:1px solid var(--line); padding-bottom:2px; transition:border-color .15s ease;}
  .contact-row a:hover{border-color:var(--teal);}

  /* signal strip */
  .signals{
    margin-top:56px;
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
    padding:18px 0;
    display:flex; flex-wrap:wrap; gap:10px 40px;
    color:var(--muted);
  }
  .signals span b{color:var(--ink); font-weight:500;}

  /* ---------- SECTION SHELL ---------- */
  section{padding:88px 0;}
  section + section{border-top:1px solid var(--line);}
  .section-head{
    display:flex; align-items:baseline; justify-content:space-between;
    gap:24px; margin-bottom:48px;
  }
  .section-head h2{font-size:30px;}
  .section-head .count{color:var(--muted);}

  /* ---------- EXPERIENCE / ROADMAP ---------- */
  .roadmap{position:relative;}
  .roadmap::before{
    content:"";
    position:absolute; left:7px; top:8px; bottom:8px;
    width:1px; background:var(--line);
  }
  .role{
    position:relative;
    padding-left:38px;
    padding-bottom:64px;
  }
  .role:last-child{padding-bottom:0;}
  .role::before{
    content:"";
    position:absolute; left:0; top:6px;
    width:15px; height:15px;
    border-radius:50%;
    background:var(--paper);
    border:2px solid var(--teal);
  }
  .role.current::before{background:var(--teal);}
  .role-top{
    display:flex; flex-wrap:wrap; align-items:baseline;
    gap:8px 16px; margin-bottom:6px;
  }
  .role-title{font-family:'Fraunces', serif; font-size:22px; font-weight:600;}
  .role-org{color:var(--teal); font-size:15px;}
  .role-time{color:var(--muted); margin-left:auto;}
  .role-project{
    font-size:14.5px; color:var(--muted); font-style:italic; margin-bottom:14px;
  }
  .role ul{
    margin:0; padding-left:18px;
    max-width:70ch;
  }
  .role li{margin-bottom:9px; padding-left:2px;}
  .role li::marker{color:var(--teal);}
  .role-tags{margin-top:16px; display:flex; flex-wrap:wrap; gap:8px;}
  .role-tags span{
    font-family:'IBM Plex Mono', monospace; font-size:11.5px;
    padding:4px 9px; border:1px solid var(--line); border-radius:3px;
    color:var(--muted);
  }
  .role.compact{padding-bottom:36px;}
  .role.compact .role-title{font-size:18px;}

  /* ---------- SKILLS ---------- */
  .skill-grid{
    display:grid; grid-template-columns:1fr; gap:36px;
  }
  @media(min-width:720px){.skill-grid{grid-template-columns:1fr 1fr;}}
  .skill-group h3{
    font-family:'IBM Plex Mono', monospace; font-weight:500;
    font-size:13px; color:var(--teal); margin-bottom:14px;
    text-transform:lowercase;
  }
  .skill-group .pillbox{display:flex; flex-wrap:wrap; gap:8px;}
  .skill-group .pillbox span{
    font-size:14px; padding:6px 12px;
    background:var(--paper-dim);
    border-radius:3px;
  }

  /* ---------- EDUCATION / CERTS ---------- */
  .two-col{display:grid; grid-template-columns:1fr; gap:56px;}
  @media(min-width:720px){.two-col{grid-template-columns:1fr 1fr;}}
  .entry{padding:16px 0; border-bottom:1px solid var(--line);}
  .entry:last-child{border-bottom:none;}
  .entry-title{font-weight:500; font-size:15.5px;}
  .entry-sub{color:var(--muted); font-size:14px; margin-top:2px;}

  /* ---------- AWARDS ---------- */
  .awards{display:grid; grid-template-columns:1fr; gap:0;}
  @media(min-width:640px){.awards{grid-template-columns:1fr 1fr;}}
  .award{
    padding:20px 22px; border:1px solid var(--line);
    margin:-1px 0 0 -1px;
  }
  .award-name{font-weight:500; font-size:15px; color:var(--gold);}
  .award-desc{color:var(--muted); font-size:13.5px; margin-top:6px;}

  /* ---------- FOOTER ---------- */
  footer{padding:72px 0 96px;}
  footer h2{font-size:32px; max-width:16ch; margin-bottom:28px;}
  .cta-row{display:flex; flex-wrap:wrap; gap:16px;}
  .cta{
    font-size:15px; text-decoration:none;
    padding:13px 22px; border-radius:3px;
    border:1px solid var(--ink);
    transition:background .15s ease, color .15s ease;
  }
  .cta.primary{background:var(--ink); color:var(--paper);}
  .cta.primary:hover{background:var(--teal); border-color:var(--teal);}
  .cta.ghost:hover{background:var(--ink); color:var(--paper);}
  .foot-meta{
    margin-top:64px; padding-top:24px; border-top:1px solid var(--line);
    display:flex; justify-content:space-between; color:var(--muted); font-size:13px;
    flex-wrap:wrap; gap:10px;
  }

  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{transition:none !important;}
  }
</style>
